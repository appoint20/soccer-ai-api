# --- STAGE 1: .NET BUILD ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS dotnet-build
WORKDIR /src
COPY src/soccer-ai-worker/soccer-ai-worker.csproj src/soccer-ai-worker/
COPY src/soccer-ai-application/soccer-ai-application.csproj src/soccer-ai-application/
COPY src/soccer-ai-infrastructure/soccer-ai-infrastructure.csproj src/soccer-ai-infrastructure/
RUN dotnet restore src/soccer-ai-worker/soccer-ai-worker.csproj
COPY . .
RUN dotnet publish src/soccer-ai-worker/soccer-ai-worker.csproj -c Release -o /app/publish --no-restore

# --- STAGE 2: FINAL RUNTIME ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=dotnet-build /app/publish .

# The host watches appsettings*.json for changes by default, and every watcher
# is an inotify instance. Config files are baked into this image and can never
# change, so the watchers buy nothing — but the kernel's inotify limit (128) is
# per-UID across the whole host, and a restarting container exhausts it. Once it
# is gone the process cannot even build its configuration:
#   IOException: The configured user limit (128) on the number of inotify
#   instances has been reached
# Set here rather than in render.yaml so it applies even when the Blueprint is
# not in effect.
ENV DOTNET_hostBuilder__reloadConfigOnChange=false

# Directory for the legacy SQLite volume (when Provider=Sqlite)
RUN mkdir -p /app/data

ENTRYPOINT ["dotnet", "soccer-ai-worker.dll"]
