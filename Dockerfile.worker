FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /app

COPY . ./
RUN dotnet restore src/soccer-gpt-worker/soccer-gpt-worker.csproj
RUN dotnet publish src/soccer-gpt-worker/soccer-gpt-worker.csproj -c Release -o out

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build-env /app/out .
COPY --from=build-env /app/scripts/ml /scripts/ml

RUN pip3 install --no-cache-dir -r /scripts/ml/requirements.txt

ENV DB_PATH="/app/data/soccer.db"
RUN mkdir -p /app/data

ENTRYPOINT ["dotnet", "soccer-gpt-worker.dll"]
