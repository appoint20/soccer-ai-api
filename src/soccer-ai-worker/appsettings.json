{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Sync": {
    "ScheduleUtc": [ "03:30", "15:30" ],
    "StartupSyncThresholdHours": 20,
    "GenerateAiNarratives": false,
    "RecomputeDaysBack": 3,
    "RecomputeDaysAhead": 4
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/soccer.db",
    "PostgresConnection": "Host=localhost;Port=5432;Database=soccer_ai;Username=postgres;Password=postgres"
  },
  "ApiFootball": {
    "BaseUrl": "https://v3.football.api-sports.io",
    "ApiKey": ""
  },
  "AiService": {
    "BaseUrl": "https://open.bigmodel.cn/api/paas/v4/",
    "DefaultModel": "glm-4-plus",
    "ApiKey": "",
    "TimeoutSeconds": 300,
    "Enabled": true
  },
  "Calibration": {
    "MarketWeight": 0.5
  },
  "LeagueTiers": {
    "Tier1": [ 39, 40, 41, 42, 46, 5, 78, 79, 80, 140, 141, 135, 136, 61, 62 ],
    "Tier2": [ 2, 3, 848 ],
    "IncludeTier2": false,
    "Tier2QualificationThresholdBoost": 10.0
  },
  "DixonColes": {
    "MaxGoals": 8,
    "Rho": -0.13,
    "DecayHalfLifeDays": 180,
    "BayesianPriorStrength": 10,
    "VenueWeight": 0.7,
    "MinLeagueMatches": 10,
    "MinTeamMatches": 3,
    "LambdaMin": 0.2,
    "LambdaMax": 4.5,
    "MinLeagueGoalAverage": 0.1
  }
}
