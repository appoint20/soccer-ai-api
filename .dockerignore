# IMPORTANT: Force include data files (override .gitignore)
# Even though they're gitignored, we NEED them in Docker
!data/
!data/upcoming/
!data/upcoming/*.csv
!data/predictions/
!data/predictions/**/*.json
!data/historical/
!data/historical/*.xlsx
