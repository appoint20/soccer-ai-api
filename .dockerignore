# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
**/.venv/
ENV/
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

